<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tuempresa.demosolicitud_estudiante.Controller.PrincipalController"
      prefHeight="600.0"
      prefWidth="900.0"
      spacing="25.0"
      alignment="TOP_CENTER"
      fillWidth="true">

    <MenuBar maxWidth="Infinity">

        <Menu text="Opciones">

            <MenuItem text="Registrar cliente"
                      onAction="#abrirRegistro"/>

            <MenuItem text="Consultar clientes"
                      onAction="#abrirConsulta"/>

            <SeparatorMenuItem/>

            <MenuItem text="Salir"
                      onAction="#salir"/>

        </Menu>

    </MenuBar>

    <ToolBar maxWidth="Infinity">

        <Button text="Registrar"
                onAction="#abrirRegistro"/>

        <Button text="Consultar"
                onAction="#abrirConsulta"/>

    </ToolBar>

    <Label text="SISTEMA DE GESTIÓN DE SOLICITUDES"
           style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <Label text="Menú Principal"
           style="-fx-font-size: 18px;"/>

    <VBox alignment="CENTER"
          spacing="20.0"
          VBox.vgrow="ALWAYS">

        <Button text="Registrar cliente"
                prefWidth="250.0"
                prefHeight="50.0"
                onAction="#abrirRegistro"/>

        <Button text="Consultar clientes"
                prefWidth="250.0"
                prefHeight="50.0"
                onAction="#abrirConsulta"/>

    </VBox>

    <padding>
        <Insets bottom="30.0"/>
    </padding>

</VBox>