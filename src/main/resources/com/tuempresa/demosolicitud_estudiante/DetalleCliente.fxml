<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tuempresa.demosolicitud_estudiante.Controller.DetalleClienteController"
      prefHeight="600.0"
      prefWidth="550.0"
      spacing="20.0"
      alignment="TOP_CENTER">

    <Label text="Detalle del Cliente"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <ImageView fx:id="imgFotografia"
               fitWidth="150.0"
               fitHeight="150.0"
               preserveRatio="true"/>

    <GridPane hgap="15.0"
              vgap="15.0">

        <Label text="Nombre completo:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <Label fx:id="lblNombre"
               GridPane.columnIndex="1"
               GridPane.rowIndex="0"/>

        <Label text="Tipo de cliente:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <Label fx:id="lblTipoCliente"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"/>

        <Label text="Departamento:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <Label fx:id="lblCiudad"
               GridPane.columnIndex="1"
               GridPane.rowIndex="2"/>

        <Label text="Fecha de nacimiento:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <Label fx:id="lblFechaNacimiento"
               GridPane.columnIndex="1"
               GridPane.rowIndex="3"/>

        <Label text="Tipo de solicitud:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <Label fx:id="lblTipoSolicitud"
               GridPane.columnIndex="1"
               GridPane.rowIndex="4"/>

        <Label text="Servicios:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"/>

        <Label fx:id="lblServicios"
               GridPane.columnIndex="1"
               GridPane.rowIndex="5"/>

    </GridPane>

    <Button text="Volver"
            prefWidth="150.0"
            onAction="#volver"/>

    <padding>
        <Insets top="25.0"
                right="30.0"
                bottom="25.0"
                left="30.0"/>
    </padding>

</VBox>